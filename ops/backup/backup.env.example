# /etc/training-manager/backup.env
DB_PATH=/var/lib/training-manager/db/app.sqlite3
REPORTS_DIR=/var/lib/training-manager/reports
BACKUP_DIR=/var/backups/training-manager
# Clés publiques age (une par ligne). La clé privée ne doit PAS être sur le serveur.
AGE_RECIPIENTS=/etc/training-manager/backup-recipients.txt
# Copie hors machine : rsync:user@backup.example.ch:/srv/backups/training-manager  ou  rclone:remote:bucket/training-manager
BACKUP_REMOTE=
APP_DIR=/opt/training-manager/app
