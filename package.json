{
  "name": "training-manager",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Gestion des formations, présences par QR code, statistiques et rapports PDF.",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter @tm/web dev",
    "dev:mobile": "pnpm --filter @tm/mobile dev",
    "build": "pnpm --filter @tm/web build && pnpm --filter @tm/mobile build",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "pnpm --filter @tm/database generate",
    "db:migrate": "pnpm --filter @tm/database migrate",
    "db:seed": "pnpm --filter @tm/database seed",
    "pdf:dev": "cargo run --manifest-path services/pdf/Cargo.toml",
    "pdf:build": "cargo build --release --manifest-path services/pdf/Cargo.toml",
    "db:seed:demo": "pnpm --filter @tm/database seed:demo",
    "db:backup": "pnpm --filter @tm/database backup",
    "db:integrity": "pnpm --filter @tm/database integrity"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "typescript": "~5.9.3",
    "vitest": "^4.0.0"
  }
}
