# ---------------------------------------------------------------------------
# Application web / API (Nuxt) — variables NUXT_* lues à l'exécution.
# En production : /etc/training-manager/web.env (mode 0600).
# ---------------------------------------------------------------------------
HOST=127.0.0.1
PORT=3000
NODE_ENV=production

NUXT_DATABASE_PATH=/var/lib/training-manager/db/app.sqlite3
NUXT_REPORTS_DIR=/var/lib/training-manager/reports
# Migrations livrées avec le build (.output/server/migrations) ou le dépôt (database/migrations).
NUXT_MIGRATIONS_DIR=/opt/training-manager/app/database/migrations
# En production, les migrations sont lancées par le déploiement (pnpm db:migrate) après sauvegarde.
NUXT_AUTO_MIGRATE=false

NUXT_PDF_SERVICE_URL=http://127.0.0.1:8090
# Origines de l'app mobile (Capacitor iOS / Android). Ajouter http://localhost:5173 en développement.
NUXT_CORS_ORIGINS=capacitor://localhost,https://localhost
# Cookie Secure + préfixe __Host- : laisser à true derrière HTTPS.
NUXT_COOKIE_SECURE=true
# Lire l'IP client dans X-Forwarded-For (uniquement derrière le reverse proxy).
NUXT_TRUST_PROXY=true

NUXT_WEB_SESSION_TTL_HOURS=12
NUXT_MOBILE_SESSION_TTL_DAYS=30
# Validité d'un QR après la fin de sa session.
NUXT_QR_GRACE_HOURS=24

NUXT_ORGANIZATION=
NUXT_PUBLIC_TIMEZONE=Europe/Zurich
NUXT_PUBLIC_APP_NAME=Training Manager

# ---------------------------------------------------------------------------
# Initialisation (pnpm db:seed) — premier administrateur.
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=admin@example.ch
SEED_ADMIN_PASSWORD=changez-moi-12-caracteres-min
SEED_ADMIN_NAME=Administrateur

# ---------------------------------------------------------------------------
# Service PDF (Rust)
# ---------------------------------------------------------------------------
PDF_BIND=127.0.0.1:8090
RUST_LOG=info
